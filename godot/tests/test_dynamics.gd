extends SceneTree
## Actual native C# dynamics, the existing 3D renderer and UI/input path.
const Viewer=preload("res://scripts/three_d/viewer_3d.gd")
var checks:=0
var failed:=false
func check(value: bool,message: String) -> void:
    checks+=1
    if not value:failed=true;push_error(message)
func _initialize() -> void:run.call_deferred()
func capture(path: String) -> void:
    if DisplayServer.get_name()=="headless" or "--test-capture" not in OS.get_cmdline_user_args():return
    await process_frame;await RenderingServer.frame_post_draw;root.get_texture().get_image().save_png(path)
func run() -> void:
    root.size=Vector2i(1280,800);var v:=Viewer.new();root.add_child(v)
    await process_frame;await process_frame;v.set_process(false);v.action("mode:live")
    check(v.playback.morale_enabled and v.playback.cavalry_enabled,"Normal live combat enables morale and cavalry")
    check(v.hud.cavalry_orders.visible and v.hud.scenario_choices.size()==105,"Native scenario registry populates the developer selector")
    v.playback.playing=false;v.units.selected=0;v.action("live:step")
    check(v.playback.current.units[0].morale_simulated,"Live morale is authoritative")
    check(not v.hud.inspector.text.contains("Morale: not simulated"),"Inspector shows real morale")
    v.action("scenario:cascading-rout");v.playback.playing=false;v.units.selected=0;v.playback.warm_start(5);v.refresh_frame();v.refresh_ui()
    check(v.playback.backend.GetMetrics().routs>=3 and v.playback.backend.GetMetrics().cascade_shocks>0,"A local collapse cascades through the live army")
    check(v.playback.current.units[0].state=="routing" and not v.playback.current.units[0].effective,"Routing is a behavioural state")
    check(v.hud.order_buttons.hold.disabled and v.hud.order_buttons.column.disabled,"Routed formations cannot be ordered back into battle")
    check(not v.playback.issue_move(0,Vector2(800,200)) and not v.playback.issue_charge(0,4),"Native control boundary also rejects routed orders")
    check(v.effects.halo_mesh.get_surface_count()>0,"Authoritative rout events create visual feedback")
    await capture("/tmp/rtt-m3-routing.png")
    v.action("scenario:prepared-charge");v.playback.playing=false;v.units.selected=0;v.action("live:step")
    check(v.playback.current.units[0].charge_state=="charging" and v.playback.current.units[0].speed<=.201,"Cavalry begins accelerating instead of teleporting to full speed")
    v.playback.warm_start(45);v.refresh_frame();v.refresh_ui()
    check(v.playback.current.units[0].momentum>0,"Charge motion builds authoritative momentum")
    check(v.hud.inspector.text.contains("Momentum:") and v.hud.inspector.text.contains("Charge ready:"),"Existing inspector exposes cavalry lifecycle")
    await capture("/tmp/rtt-m3-charge.png")
    v.playback.warm_start(100);v.refresh_frame()
    check(v.playback.backend.GetMetrics().charge_impacts==1 and v.playback.backend.GetMetrics().failed_charges==1,"Prepared defenders repel one impact")
    check(v.playback.current.units[0].charge_result=="prepared front","Failure reason is inspectable")
    v.action("scenario:routing-pursuit");v.playback.playing=false;v.units.selected=0;v.playback.warm_start(160);v.refresh_frame();v.refresh_ui()
    var stats: Dictionary=v.playback.backend.GetMetrics()
    check(stats.pursuit_casualties>0 and stats.pursuit_losses<5,"Moving pursuit damages broken infantry with little resistance")
    check(v.playback.current.units[0].charge_state=="pursuit" and v.playback.current.units[0].speed>0,"Pursuit does not become stationary melee")
    check(v.hud.inspector.text.contains("Pursuit target:"),"Pursuit target reaches the existing panel")
    await capture("/tmp/rtt-m3-pursuit.png")
    v.action("live:hold");v.action("live:step")
    check(v.playback.current.units[0].pursuit<0,"Player Hold ends autonomous pursuit")
    v.action("live:pursue");v.action("live:step")
    check(v.playback.current.units[0].order=="pursue","Explicit pursue order is available through the UI")
    v.action("live:disengage");v.action("live:step")
    check(v.playback.current.units[0].order=="disengage" and v.playback.current.units[0].destination!=null,"Disengage creates a nearby authoritative retreat goal")
    v.action("live:reform");v.action("live:step")
    check(v.playback.current.units[0].order=="reform" and not v.playback.current.units[0].charge_ready,"Reform holds for recovery without resetting the impact lock")
    v.action("scenario:shared-pursuit");v.playback.warm_start(160);v.refresh_frame()
    check(v.playback.backend.GetMetrics().pursuit_casualties>0,"Multiple cavalry can share a pursuit")
    check(v.playback.current.units[0].position.x>470 and v.playback.current.units[1].position.x>470,"Both pursuers advance through compatible friendly congestion")
    v.action("scenario:safe-rally");v.playback.playing=false;v.units.selected=0;v.playback.warm_start(230);v.refresh_frame();v.refresh_ui()
    check(v.playback.current.units[0].state=="rallying" and not v.playback.current.units[0].effective,"Safe fugitives enter gradual rallying")
    check(not v.playback.issue_hold(0),"Rallying does not instantly restore player authority")
    v.playback.warm_start(240);v.refresh_frame();v.refresh_ui()
    check(v.playback.current.units[0].effective and v.playback.current.units[0].state=="shaken","Recovered troops return to duty below full effectiveness")
    check(v.playback.issue_move(0,Vector2(600,400)),"Returned regiments accept player orders")
    var point: Vector2=v.playback.current.units[0].position;var focus: Vector2=v.rig.focus
    Input.action_press("camera_forward");v._process(.2);Input.action_release("camera_forward")
    check(v.rig.focus!=focus and v.playback.current.units[0].position==point,"Paused camera input cannot change native battle authority")
    v.action("scenario:difficult-charge");v.playback.warm_start(100)
    check(v.playback.backend.GetMetrics().charge_starts==0,"Dense terrain prevents an open-ground charge")
    v.action("scenario:infantry-under-fire");v.playback.warm_start(6000);v.refresh_frame();v.refresh_ui()
    check(v.playback.result!="" and v.playback.completion_rule.contains("fighting strength"),"Normal live battles finish through morale collapse")
    check(not v.playback.playing and v.hud.notices.text.contains("Battle complete"),"Existing HUD reports the result and stops authority")
    var survivors: int=0
    for u in v.playback.current.units.values():survivors+=u.strength
    check(survivors>0,"Defeat does not count routed survivors as dead")
    v.action("restart");check(v.playback.tick==0 and v.playback.playing,"Reset after morale defeat restores a playable battle")
    root.size=Vector2i(800,600);await process_frame;await process_frame;v.action("scenario:prepared-charge");await process_frame
    check(v.hud.cavalry_orders.get_global_rect().end.x<=800 and v.hud.live_orders.get_global_rect().end.x<=800,"Both order rows fit at 800×600")
    check(v.hud.scenario_selector.get_parent().get_global_rect().end.x<=800,"Long scenario names do not expand the top row offscreen")
    await capture("/tmp/rtt-m3-small.png")
    v.action("mode:replay");v.seek(60)
    check(not v.is_live and v.hud.timeline.visible and not v.hud.cavalry_orders.visible,"Replay restores its original controls and timeline")
    v.queue_free();await process_frame
    print("Godot dynamics checks: %d, failed: %s" % [checks,failed]);quit(1 if failed else 0)
